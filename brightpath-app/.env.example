# Environment Variables — brightpath-app (app.brightpath-fin.com)
# Copy this file to .env.local and fill in your values

# Site URL
NEXT_PUBLIC_SITE_URL=https://app.brightpath-fin.com

# Resend API key for application email notifications
# Same Resend account as brightpath-heloc (sends from leads@brightpath-fin.com
# to team@brightpath-fin.com and contact@brightpathfinance.com)
RESEND_API_KEY=
