# Environment Variables
# Copy this file to .env.local and fill in your values

# Site URL (used for canonical URLs, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=https://freedomdebtsolutions.com

# CRM Webhook URL (Make.com webhook that routes leads)
# This receives all lead form submissions and routes to CRM + MailerLite
# Make.com Scenario: "Debt Relief Lead Router" (ID: 4579082)
CRM_WEBHOOK_URL=https://hook.us2.make.com/3rb4dw9442jqbbi6gsppa4zlbr5wlqer

# Live Transfer Webhook URL
# Triggered during business hours (Mon-Fri 9AM-6PM EST)
# Routes leads to live sales agents for immediate follow-up
# Configure this in your CRM (e.g., GHL, Close.io) or use a Make.com scenario
LIVE_TRANSFER_WEBHOOK_URL=

# Nurture Campaign Webhook URL
# Triggered outside business hours
# Starts email/SMS drip campaign to set appointments
# MailerLite Automation: "Debt Relief Lead Nurture - After Hours" (ID: 183398032200435025)
# Group: "After Hours Leads" (ID: 183397864894891165)
NURTURE_WEBHOOK_URL=

# MailerLite API Key (for direct subscriber creation)
MAILERLITE_API_KEY=

# MailerLite Group IDs
MAILERLITE_GROUP_ALL_LEADS=183397864348583424
MAILERLITE_GROUP_AFTER_HOURS=183397864894891165
MAILERLITE_GROUP_APPOINTMENT_SET=183397865431762192

# ─── Figure Technologies HELOC API ───────────────────────────────────────────
# Become a partner: https://www.figure.com/partners/
# Once onboarded, Figure will provide these credentials via their partner portal.

# OAuth 2.0 client credentials (from Figure partner portal)
FIGURE_CLIENT_ID=
FIGURE_CLIENT_SECRET=

# Your unique partner ID assigned by Figure
FIGURE_PARTNER_ID=

# API base URL (use sandbox for testing, production for live)
# Sandbox:    https://api.figure.com  (with sandbox credentials)
# Production: https://api.figure.com
FIGURE_API_BASE_URL=https://api.figure.com

# OAuth token endpoint
FIGURE_TOKEN_URL=https://api.figure.com/oauth/token

# ─── Meta (Facebook / Instagram) Ads API ────────────────────────────────────
# Docs: https://developers.facebook.com/docs/marketing-apis
# Create a Meta App at: https://developers.facebook.com/apps/
# Grant the app: ads_management, ads_read permissions
# Generate a long-lived System User token in Business Manager.

# Long-lived System User access token
META_ACCESS_TOKEN=

# Ad Account ID (format: act_XXXXXXX — find in Ads Manager)
META_AD_ACCOUNT_ID=

# Facebook Page ID (the page that will be the identity of ads)
META_PAGE_ID=

# Facebook Pixel ID for conversion tracking (optional but recommended)
META_PIXEL_ID=

# Secret to protect the /api/meta-ads endpoint (generate a random string)
META_ADS_API_SECRET=
