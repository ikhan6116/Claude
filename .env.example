# Environment Variables
# Copy this file to .env.local and fill in your values

# Site URL (used for canonical URLs, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=https://freedomdebtsolutions.com

# CRM Webhook URL (Make.com webhook that routes leads)
# This receives all lead form submissions and routes to CRM + MailerLite
# Make.com Scenario: "Debt Relief Lead Router" (ID: 4579082)
CRM_WEBHOOK_URL=https://hook.us2.make.com/3rb4dw9442jqbbi6gsppa4zlbr5wlqer

# Live Transfer Webhook URL
# Triggered during business hours (Mon-Fri 9AM-6PM EST)
# Routes leads to live sales agents for immediate follow-up
# Configure this in your CRM (e.g., GHL, Close.io) or use a Make.com scenario
LIVE_TRANSFER_WEBHOOK_URL=

# Nurture Campaign Webhook URL
# Triggered outside business hours
# Starts email/SMS drip campaign to set appointments
# MailerLite Automation: "Debt Relief Lead Nurture - After Hours" (ID: 183398032200435025)
# Group: "After Hours Leads" (ID: 183397864894891165)
NURTURE_WEBHOOK_URL=

# MailerLite API Key (for direct subscriber creation)
MAILERLITE_API_KEY=

# MailerLite Group IDs
MAILERLITE_GROUP_ALL_LEADS=183397864348583424
MAILERLITE_GROUP_AFTER_HOURS=183397864894891165
MAILERLITE_GROUP_APPOINTMENT_SET=183397865431762192

# ─── Figure Technologies HELOC API ───────────────────────────────────────────
# Obtain credentials from your Figure partner portal: https://partners.figure.com
FIGURE_API_BASE_URL=https://api.figure.com
FIGURE_API_KEY=your_figure_api_key_here
FIGURE_PARTNER_ID=your_partner_id_here

# ─── Meta (Facebook / Instagram) Marketing API ───────────────────────────────
# Create an app at https://developers.facebook.com and generate a long-lived
# system user access token scoped to ads_management, ads_read, pages_read_engagement
META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=act_your_account_id
META_APP_ID=your_app_id_here
# Facebook Page ID used to publish ads (find in Page Settings > About)
META_PAGE_ID=your_facebook_page_id

# ─── HELOC Campaign Settings ─────────────────────────────────────────────────
# Full URL where the HELOC application form is hosted
HELOC_FORM_URL=https://yourdomain.com/heloc/apply

# ─── Admin / Internal ────────────────────────────────────────────────────────
# Secret token required to call protected admin API routes (e.g., /api/ads/launch-campaign)
# Generate with: openssl rand -hex 32
ADMIN_SECRET=your_admin_secret_here

# ─── MEGHAN — AI Veterinary Agent ────────────────────────────────────────────
# Anthropic API key that powers MEGHAN's chat (/meghan, /api/meghan/chat).
# Get one at https://console.anthropic.com/settings/keys
# Without this key MEGHAN runs in a limited "demo mode" and returns a friendly
# placeholder reply instead of a live answer.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: override the Claude model MEGHAN uses (defaults to claude-sonnet-5).
MEGHAN_MODEL=claude-sonnet-5
