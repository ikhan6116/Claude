# Environment Variables — mtgikhan-form (form.mtgikhan.com)
# Copy this file to .env.local and fill in your values

# Public site URL
NEXT_PUBLIC_SITE_URL=https://form.mtgikhan.com

# Resend API key for application email notifications.
# Notifications are sent to team@brightpath-fin.com and contact@brightpathfinance.com.
RESEND_API_KEY=

# The verified "from" address/sender used with Resend.
# The domain here MUST be verified in your Resend account.
# Defaults to "BrightPath Applications <leads@brightpath-fin.com>" if unset.
RESEND_FROM=BrightPath Applications <leads@brightpath-fin.com>
